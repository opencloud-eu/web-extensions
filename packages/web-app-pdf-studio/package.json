{
  "name": "pdf-studio",
  "version": "1.0.0",
  "private": true,
  "description": "OpenCloud Web PDF Studio: view, annotate, fill forms and rearrange pages, based on PDF.js",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest"
  },
  "dependencies": {
    "@vueuse/core": "^14.0.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@opencloud-eu/design-system": "^8.1.0",
    "@opencloud-eu/web-client": "^8.1.0",
    "@opencloud-eu/web-pkg": "^8.1.0",
    "vite-plugin-static-copy": "^4.0.0",
    "vue": "^3.4.21",
    "vue3-gettext": "^4.0.0"
  }
}
